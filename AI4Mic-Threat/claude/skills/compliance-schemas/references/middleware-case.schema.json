{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "middleware-case.schema.json",
  "title": "MiddlewareCaseList",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["caseId", "baselineType", "result"],
    "additionalProperties": false,
    "properties": {
      "caseId": { "type": "string" },
      "baselineType": { "type": "string" },
      "result": {
        "type": "string",
        "enum": ["PASS", "FAIL", "ERROR", "SKIP"]
      },
      "execTime": { "type": "string", "format": "date-time" },
      "evidenceUri": { "type": "string" },
      "targetService": { "type": "string" }
    }
  }
}
