{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "service-context.schema.json",
  "title": "ServiceContext",
  "type": "object",
  "required": ["service", "entryPoints", "dataStores", "externalCalls", "sensitiveAssets"],
  "additionalProperties": false,
  "properties": {
    "service": { "type": "string", "minLength": 1 },
    "role": { "type": "string" },
    "entryPoints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "dataStores": {
      "type": "array",
      "items": { "type": "string" }
    },
    "externalCalls": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sensitiveAssets": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
