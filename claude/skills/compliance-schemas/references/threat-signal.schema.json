{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "threat-signal.schema.json",
  "title": "ThreatSignalList",
  "type": "object",
  "required": ["service", "signalType", "signals"],
  "additionalProperties": false,
  "properties": {
    "service": { "type": "string" },
    "signalType": {
      "type": "string",
      "enum": ["exposure", "dataflow", "controlplane"]
    },
    "signals": {
      "type": "array",
      "items": { "$ref": "#/$defs/threatSignal" }
    }
  },
  "$defs": {
    "threatSignal": {
      "type": "object",
      "required": ["signalId", "domain", "strength", "serviceLevelSummary", "confidence"],
      "additionalProperties": false,
      "properties": {
        "signalId": { "type": "string" },
        "domain": { "type": "string" },
        "strength": {
          "type": "string",
          "enum": ["confirmed", "likely", "absent", "not_applicable"]
        },
        "serviceLevelSummary": { "type": "string" },
        "anchors": {
          "type": "array",
          "maxItems": 3,
          "items": { "type": "string" }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
