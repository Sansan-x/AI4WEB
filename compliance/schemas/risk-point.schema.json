{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "risk-point.schema.json",
  "title": "RiskPoint",
  "type": "object",
  "required": ["riskId", "service", "category", "severity", "status"],
  "additionalProperties": false,
  "properties": {
    "riskId": { "type": "string" },
    "service": { "type": "string" },
    "category": { "type": "string" },
    "severity": {
      "type": "string",
      "enum": ["P0", "P1", "P2", "P3"]
    },
    "status": {
      "type": "string",
      "enum": ["Open", "Mitigated", "Accepted"]
    },
    "codeEvidence": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 3
    },
    "serviceLevelSummary": { "type": "string" }
  }
}
