{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "service-slices.schema.json",
  "title": "ServiceSlices",
  "type": "object",
  "required": ["runId", "repoPath", "services"],
  "properties": {
    "runId": { "type": "string" },
    "repoPath": { "type": "string" },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["serviceName", "sourcePaths"],
        "properties": {
          "serviceName": { "type": "string" },
          "sourcePaths": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
