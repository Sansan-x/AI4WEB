{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision.schema.json",
  "title": "ComplianceDecision",
  "type": "object",
  "required": ["decision", "reasons"],
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["Pass", "ConditionalPass", "Block"]
    },
    "reasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "policyVersion": { "type": "string" },
    "policyMode": { "type": "string" },
    "serviceSummaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["service", "decision", "path"],
        "properties": {
          "service": { "type": "string" },
          "decision": {
            "type": "string",
            "enum": ["Pass", "ConditionalPass", "Block"]
          },
          "path": { "type": "string" }
        }
      }
    }
  }
}
